# Database - Turso SQLite edge
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-token

# Auth - NextAuth.js v5
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-min-32-chars
# Local dev only — on Vercel this is auto-detected
NEXTAUTH_URL=http://localhost:3000

# IMS SSO handoff (this app is the HR child). Shared with IMS SSO_SHARED_SECRET.
# Minimum 32 characters. Must be different from AUTH_SECRET.
# Generate with: openssl rand -base64 48
SSO_SHARED_SECRET=your-sso-shared-secret-min-32-chars-not-auth-secret

# Africa's Talking SMS
# Get your LIVE API key from: africastalking.com → Dashboard → API Key (NOT the sandbox key)
AT_API_KEY=your-live-api-key-from-at-dashboard
# Your AT username (shown on AT dashboard — NOT "sandbox")
AT_USERNAME=GAKISMS
# Sender ID — only set if you have a registered/approved alphanumeric ID with AT
# Leave blank (or omit) to use AT's shared shortcode (works without registration)
AT_SENDER_ID=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PWA
ENABLE_PWA=false
