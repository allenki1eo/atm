# Database - Turso SQLite edge
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-token

# Auth - NextAuth.js v5
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-min-32-chars
# Local dev only — on Vercel this is auto-detected
NEXTAUTH_URL=http://localhost:3000

# IMS SSO handoff (this app is the HR child). Shared with IMS SSO_SHARED_SECRET.
# Minimum 32 characters. Must be different from AUTH_SECRET.
# Generate with: openssl rand -base64 48
SSO_SHARED_SECRET=your-sso-shared-secret-min-32-chars-not-auth-secret

# Swala SMS (https://swalasms.com)
# Create a key in the SwalaSMS dashboard: https://swalasms.com/sms/api-keys
# Live keys start with swl_live_. Sandbox keys (swl_test_) do not deliver to real phones.
# Do not commit the real key.
SWALA_API_KEY=
# Approved sender ID on the Swala account. POSTSMS is the sender ID used on other apps.
SWALA_SENDER_ID=POSTSMS

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PWA
ENABLE_PWA=false
