# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep .env.example)
.env
.env.local
.env.*.local

# Local SQLite database
*.db
*.db-journal
*.db-shm
*.db-wal

# PWA service worker (generated at build)
public/sw.js
public/sw.js.map
public/workbox-*.js

# vercel
.vercel

# Claude Code session data
.claude/

# typescript
*.tsbuildinfo
next-env.d.ts
